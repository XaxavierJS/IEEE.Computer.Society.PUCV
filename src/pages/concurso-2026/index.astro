  map: 'M9 6.75V15m0-8.25a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 0v5.25m0 0a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m3-15V15m0-8.25a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 2.25V15',
  cpu: 'M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z',
  link: 'M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244',
  rocket: 'M15.59 14.37a48.475 48.475 0 00-6.05-5.452c-.37-.3-.52-.757-.392-1.182.304-1.005.75-1.968 1.36-2.852C12.025 2.83 14.393 1.5 17.25 1.5c.414 0 .75.336.75.75v3.927c0 .215-.064.425-.183.607a48.111 48.111 0 00-2.227 3.592zM15.59 14.37a47.55 47.55 0 01-1.477 2.348c-.182.282-.392.367-.607.367H9.578a.75.75 0 01-.643-.364 48.474 48.474 0 01-1.567-2.816m8.222.465l.003-.002M6 18.75a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z',
  envelope: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75'
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Concurso de Emprendimiento e Innovación 2026',
  description: 'Concurso de innovación para estudiantes de enseñanza media de la Región de Valparaíso. Crea una app móvil con Design Thinking y Thunkable.',
  startDate: '2026-04-04',
  endDate: '2026-06-18',
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'Pontificia Universidad Católica de Valparaíso',
    address: { '@type': 'PostalAddress', addressLocality: 'Valparaíso', addressCountry: 'CL' }
  },
  organizer: {
    '@type': 'Organization',
    name: 'IEEE Computer Society PUCV',
    url: 'https://www.ieeepucv.computer'
  }
};
---

<Layout
  title="Concurso de Emprendimiento e Innovación 2026 | IEEE CS PUCV"
  description="Participa en el Concurso de Emprendimiento e Innovación 2026 de IEEE CS PUCV. Crea una app con Design Thinking y Thunkable. Equipos de 7° a 4° medio, Región de Valparaíso."
>
  <Navbar />
  <main>

    <!-- ═══════ HERO ═══════ -->
    <section class="relative py-20 lg:py-32 overflow-hidden bg-gradient-to-b from-neutral-50 via-neutral-50 to-white">
      <div class="absolute top-20 right-0 w-96 h-96 bg-ieee-orange/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-ieee-blue/5 rounded-full blur-3xl"></div>

      <Container class="relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 bg-ieee-orange/10 text-ieee-orange px-4 py-2 rounded-full text-sm font-medium mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ieee-orange opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-ieee-orange"></span>
            </span>
            {hero.badge}
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-neutral-900 mb-6 leading-tight">
            {hero.title}
            <span class="text-ieee-orange"> {hero.titleHighlight}</span>
          </h1>

          <p class="text-xl lg:text-2xl text-neutral-600 font-medium mb-4 leading-relaxed">
            {hero.subtitle}
          </p>

          <p class="text-lg text-neutral-600 mb-6 leading-relaxed max-w-3xl mx-auto">
            {hero.description}
          </p>

          <p class="text-base text-ieee-orange font-semibold mb-10">
            {hero.hook}
          </p>

          <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            <Button href={applicationFormUrl} variant="primary" size="lg">
              {hero.ctaPrimary}
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
            <Button href={contestDocumentUrl} variant="outline" size="lg">
              {hero.ctaSecondary}
            </Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══════ ABOUT ═══════ -->
    <section id="sobre" class="py-20 lg:py-28 bg-white">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{about.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {about.title} <span class="text-ieee-orange">{about.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed">{about.description}</p>
          <p class="text-base text-neutral-500 mt-4 leading-relaxed">{about.descriptionExtra}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {about.highlights.map((item) => (
            <Card class="p-6 text-center" hover={true}>
              <div class="w-12 h-12 bg-ieee-orange/10 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[item.icon]} />
                </svg>
              </div>
              <h3 class="font-bold text-neutral-900 text-lg mb-2">{item.title}</h3>
              <p class="text-neutral-600 text-sm">{item.description}</p>
            </Card>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══════ OBJECTIVES ═══════ -->
    <section class="py-20 lg:py-28 bg-neutral-50">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{objectives.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {objectives.title} <span class="text-ieee-orange">{objectives.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed">{objectives.intro}</p>
        </div>

        <div class="max-w-3xl mx-auto">
          <div class="border-l-4 border-ieee-orange bg-white rounded-r-2xl p-6 mb-10 shadow-sm">
            <p class="text-neutral-700 text-lg leading-relaxed font-medium">{objectives.general}</p>
          </div>

          <div class="space-y-4">
            {objectives.specific.map((item, i) => (
              <div class="flex items-start gap-4 bg-white border border-neutral-200 rounded-xl p-5">
                <span class="flex-shrink-0 w-8 h-8 bg-ieee-orange/10 text-ieee-orange font-bold rounded-lg flex items-center justify-center text-sm">
                  {i + 1}
                </span>
                <p class="text-neutral-700 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══════ REQUIREMENTS ═══════ -->
    <section class="py-20 lg:py-28 bg-white">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{requirements.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {requirements.title} <span class="text-ieee-orange">{requirements.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed mb-3">{requirements.intro}</p>
          <p class="text-xl text-neutral-700 font-medium">{requirements.target}</p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto mb-8">
          {requirements.items.map((item) => (
            <Card class="p-5 flex items-start gap-4" hover={true}>
              <div class="w-10 h-10 bg-ieee-orange/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[item.icon]} />
                </svg>
              </div>
              <p class="text-neutral-700 font-medium">{item.text}</p>
            </Card>
          ))}
        </div>

        <div class="max-w-3xl mx-auto bg-ieee-blue/5 border border-ieee-blue/20 rounded-xl p-5 text-center">
          <p class="text-neutral-700 text-sm">{requirements.note}</p>
          <a
            href={contestDocumentUrl}
            class="mt-3 inline-flex text-sm font-semibold text-ieee-blue hover:text-ieee-blue-dark transition-colors"
          >
            Ver documento oficial del concurso
          </a>
        </div>
      </Container>
    </section>

    <!-- ═══════ METHODOLOGY ═══════ -->
    <section class="py-20 lg:py-28 bg-neutral-50">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{methodology.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {methodology.title} <span class="text-ieee-orange">{methodology.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600">{methodology.description}</p>
          <p class="text-base text-neutral-500 mt-4 leading-relaxed">{methodology.descriptionExtra}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {methodology.pillars.map((pillar) => (
            <Card class="p-6 text-center" hover={true}>
              <div class="w-12 h-12 bg-ieee-orange/10 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[pillar.icon]} />
                </svg>
              </div>
              <h3 class="font-bold text-neutral-900 text-lg mb-2">{pillar.title}</h3>
              <p class="text-neutral-600 text-sm">{pillar.description}</p>
            </Card>
          ))}
        </div>
      </Container>
    </section>


    <!-- ═══════ TIMELINE ═══════ -->
    <section id="cronograma" class="py-20 lg:py-28 bg-white">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{timeline.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {timeline.title} <span class="text-ieee-orange">{timeline.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed">{timeline.intro}</p>
        </div>

        <div class="max-w-3xl mx-auto">
          <div class="relative pl-8 border-l-2 border-ieee-orange/30 space-y-10">
            {timeline.events.map((event, i) => (
              <div class="relative">
                <div class="absolute -left-[2.35rem] top-1 w-5 h-5 rounded-full border-2 border-ieee-orange bg-white flex items-center justify-center">
                  <div class="w-2 h-2 rounded-full bg-ieee-orange"></div>
                </div>
                <Badge variant="orange" class="text-xs px-3 py-1 mb-2">{event.date}</Badge>
                <h3 class="text-lg font-bold text-neutral-900 mt-1">{event.title}</h3>
                <p class="text-neutral-600 text-sm mt-1 leading-relaxed">{event.description}</p>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══════ EVALUATION ═══════ -->
    <section class="py-20 lg:py-28 bg-neutral-50">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{evaluation.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {evaluation.title} <span class="text-ieee-orange">{evaluation.titleHighlight}</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {evaluation.phases.map((phase) => (
            <Card class="p-8" hover={true}>
              <span class="text-5xl font-bold text-ieee-orange">{phase.number}</span>
              <h3 class="text-2xl font-bold text-neutral-900 mt-3">{phase.title}</h3>
              <p class="text-ieee-orange font-medium text-sm mt-1">{phase.subtitle}</p>
              <p class="text-neutral-600 mt-4 leading-relaxed">{phase.description}</p>
              {phase.detail && (
                <p class="mt-3 text-sm text-neutral-500 italic">{phase.detail}</p>
              )}
            </Card>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══════ PRIZES ═══════ -->
    <section class="py-20 lg:py-28 bg-white">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{prizes.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {prizes.title} <span class="text-ieee-orange">{prizes.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed">{prizes.intro}</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {prizes.items.map((item) => (
            <Card class="p-6 text-center" hover={true}>
              <div class="w-12 h-12 bg-ieee-orange/10 rounded-xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[item.icon]} />
                </svg>
              </div>
              <h3 class="font-bold text-neutral-900 text-lg mb-2">{item.title}</h3>
              <p class="text-neutral-600 text-sm">{item.description}</p>
            </Card>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══════ BENEFITS EXTRA ═══════ -->
    <section class="py-12 lg:py-16 bg-neutral-50">
      <Container>
        <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
          <div class="pointer-events-none absolute inset-y-0 left-0 w-1.5 bg-ieee-blue"></div>
          <div class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full bg-ieee-blue/8 blur-3xl"></div>

          <div class="relative z-10 max-w-3xl mx-auto text-center">
            <Badge variant="blue" class="text-sm px-4 py-1.5 mb-4">{benefits.badge}</Badge>
            <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">
              {benefits.title} <span class="text-ieee-blue">{benefits.titleHighlight}</span>
            </h2>
            <p class="text-neutral-600 leading-relaxed">{benefits.description}</p>
            <p class="text-ieee-blue font-medium mt-3">{benefits.descriptionExtra}</p>
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══════ IMPACT ═══════ -->
    <section class="py-20 lg:py-28 bg-white">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{impact.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {impact.title} <span class="text-ieee-orange">{impact.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed">{impact.intro}</p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {impact.items.map((item) => (
            <Card class="p-6 flex items-start gap-4" hover={true}>
              <div class="w-10 h-10 bg-ieee-orange/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[item.icon]} />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-neutral-900 mb-1">{item.title}</h3>
                <p class="text-neutral-600 text-sm">{item.description}</p>
              </div>
            </Card>
          ))}
        </div>
      </Container>
    </section>

    <!-- ═══════ CTA FINAL ═══════ -->
    <section class="py-16 lg:py-24 bg-neutral-50">
      <Container>
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl lg:text-4xl font-bold text-neutral-900 mb-4">
            ¿Listo para dar <span class="text-ieee-orange">el paso?</span>
          </h2>
          <p class="text-lg text-neutral-600 mb-4 leading-relaxed">
            Este concurso no es solo una competencia — es la oportunidad de descubrir que puedes crear algo que importa. No necesitas experiencia previa, solo curiosidad y un equipo con ganas.
          </p>
          <p class="text-base text-neutral-500 mb-8 leading-relaxed">
            Miles de grandes ideas empezaron con alguien que dijo "¿y si...?". Que esa persona seas tú.
          </p>
          <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            <Button href={applicationFormUrl} variant="primary" size="lg">
              Postular mi equipo
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
            <Button href="#faq" variant="outline" size="lg">
              Tengo preguntas
            </Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══════ FAQ ═══════ -->
    <section id="faq" class="py-16 lg:py-20 bg-neutral-50">
      <Container>
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{faq.badge}</span>
            <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-4">
              {faq.title} <span class="text-ieee-orange">{faq.titleHighlight}</span>
            </h2>
          </div>

          <div class="space-y-4">
            {faq.items.map((item) => (
              <details class="bg-white border border-neutral-200 rounded-xl p-5 group min-w-0">
                <summary class="cursor-pointer list-none font-semibold text-neutral-900 pr-8 relative">
                  {item.question}
                  <span class="absolute right-0 top-0 text-ieee-orange transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-neutral-600 leading-relaxed break-words [overflow-wrap:anywhere]">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- ═══════ CONTACT ═══════ -->
    <section id="contacto" class="py-20 lg:py-28 bg-white">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">{contact.badge}</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
            {contact.title} <span class="text-ieee-orange">{contact.titleHighlight}</span>
          </h2>
          <p class="text-lg text-neutral-600 leading-relaxed">{contact.description}</p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-10">
          {contact.people.map((person) => (
            <Card class="p-6 text-center w-full sm:w-auto sm:min-w-[280px]" hover={true}>
              <div class="w-12 h-12 bg-ieee-orange/10 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths.envelope} />
                </svg>
              </div>
              <h3 class="font-bold text-neutral-900">{person.name}</h3>
              <p class="text-sm text-neutral-500 mb-2">{person.role}</p>
              <a
                href={`mailto:${person.email}`}
                class="text-sm text-ieee-orange hover:text-ieee-orange-dark font-medium transition-colors break-all"
              >
                {person.email}
              </a>
            </Card>
          ))}
        </div>

        <div class="flex justify-center">
          <Button href={`${baseUrl}#inicio`} variant="ghost" size="md">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al inicio
          </Button>
        </div>
      </Container>
    </section>

  </main>
  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
<script type="application/ld+json" set:html={JSON.stringify(eventSchema)}></script>
