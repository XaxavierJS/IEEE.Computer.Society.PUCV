---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import contestData from '../../data/concurso-2026.json';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const applicationFormUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdU28D0HWLJCcMSbP5BkmWZrDr3njwAeBlCz5GLCAL1EyrxVQ/viewform?usp=dialog';
const contestDocumentUrl = 'https://docs.google.com/document/d/14d4ar3qu62nnOBzITlaXRKcsQ1UVxoZUZxPbC8k9SG0/edit?usp=sharing';

const { hero, about, objectives, requirements, methodology, timeline, evaluation, prizes, benefits, impact, faq, contact } = contestData;

const iconPaths: Record<string, string> = {
