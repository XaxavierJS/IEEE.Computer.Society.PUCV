---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const contestPath = `${baseUrl}concurso-2026`;
---

<section aria-labelledby="concurso-2026-cta" class="py-12 lg:py-16 bg-neutral-50">
  <Container>
    <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
      <div class="pointer-events-none absolute inset-y-0 left-0 w-1.5 bg-ieee-orange"></div>
      <div class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full bg-ieee-orange/8 blur-3xl"></div>

      <div class="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ieee-orange">Novedad 2026</p>
          <h2 id="concurso-2026-cta" class="mt-2 text-2xl font-bold leading-tight text-neutral-900 sm:text-3xl">
            Concurso IEEE CS PUCV 2026
          </h2>
          <p class="mt-3 text-base leading-relaxed text-neutral-600 sm:text-lg">
            Participa en un desafio de innovacion y tecnologia con premios, mentoria y visibilidad para tu equipo.
            Revisa requisitos, fechas y como postular en la pagina oficial del concurso.
          </p>
        </div>

        <div class="flex w-full shrink-0 lg:w-auto">
          <Button
            href={contestPath}
            variant="primary"
            size="lg"
            class="w-full justify-center shadow-md transition-transform duration-300 hover:-translate-y-0.5 hover:shadow-lg lg:w-auto"
          >
            Ir a Concurso 2026
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
