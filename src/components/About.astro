---
import Container from './ui/Container.astro';
import Card from './ui/Card.astro';
import landingContent from '../data/landing-content.json';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const { about } = landingContent;
---

<section id="nosotros" class="py-20 lg:py-28 bg-white">
  <Container>
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left content -->
      <div>
        <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">
          {about.badge}
        </span>
        <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6 leading-tight">
          {about.titlePrefix} 
          <span class="text-ieee-orange">{about.titleHighlight}</span>?
        </h2>
        
        <div class="space-y-4 text-neutral-600 leading-relaxed">
          <p>
            {about.paragraph1}
          </p>
          <p>
            {about.paragraph2}
          </p>
          <p>
            Somos parte de la <a href="https://www.inf.ucv.cl/" target="_blank" rel="noopener noreferrer" class="text-ieee-orange hover:text-ieee-orange-dark font-semibold underline underline-offset-2">Escuela de Ingeniería Informática PUCV</a>,
            {about.paragraph3Suffix}
          </p>
        </div>

        <!-- Info box with founding year option -->
        <div class="mt-8 p-6 bg-neutral-50 rounded-2xl border border-neutral-200">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-ieee-orange/10 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-ieee-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-neutral-900">{about.infoBoxTitle}</h3>
              <p class="text-sm text-neutral-500 mt-1">
                {about.infoBoxDescription}
              </p>
            <p class="text-sm text-ieee-orange mt-2 font-medium">{about.foundedText}</p> 
            </div>
          </div>
        </div>
      </div>

      <!-- Right side - IBC Photo and stats -->
      <div class="space-y-6">
        <!-- IBC Photo -->
        <div class="relative overflow-hidden rounded-2xl shadow-xl">
          <img 
            src={`${baseUrl}assets/About/IBC-768.webp`}
            srcset={`${baseUrl}assets/About/IBC-768.webp 768w, ${baseUrl}assets/About/IBC.webp 1280w`}
            sizes="(max-width: 1024px) 100vw, 50vw"
            alt="Edificio IBC - Escuela de Ingeniería Informática PUCV"
            width="1600"
            height="900"
            class="w-full h-64 lg:h-80 object-cover"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
          <div class="absolute inset-0 bg-gradient-to-t "></div>
          <div class="absolute bottom-4 left-4 right-4 text-white">
            <p class="text-sm font-medium">{about.campusImageCaption}</p>
          </div>
        </div>

        <!-- Stats grid -->
        <div class="grid grid-cols-2 gap-4">
          {about.stats.map((stat) => (
            <Card class="p-4 text-center" hover={true}>
              <div class={`text-2xl lg:text-3xl font-bold ${stat.valueClass}`}>{stat.value}</div>
              <div class="text-xs text-neutral-500 mt-1">{stat.label}</div>
            </Card>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
