---
import Container from './ui/Container.astro';
import landingContent from '../data/landing-content.json';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

const { gallery } = landingContent;

const galleryItemStyles = [
  {
    wrapperClass: 'lg:col-span-2 aspect-[4/3] md:aspect-[16/9] lg:aspect-[2/1]',
    overlayClass: 'from-black/80 via-black/40 to-transparent',
    contentPaddingClass: 'p-4 md:p-6',
    titleClass: 'text-lg md:text-xl lg:text-2xl font-bold mb-1 md:mb-2',
    descriptionClass: 'text-xs md:text-sm text-white/80 max-w-xl',
    zoomWrapperClass: 'w-14 h-14',
    zoomIconClass: 'w-7 h-7'
  },
  {
    wrapperClass: 'aspect-square lg:aspect-auto lg:row-span-2',
    overlayClass: 'from-black/80 via-black/20 to-transparent',
    contentPaddingClass: 'p-6',
    titleClass: 'text-xl font-bold mb-2',
    descriptionClass: 'text-sm text-white/80',
    zoomWrapperClass: 'w-14 h-14',
    zoomIconClass: 'w-7 h-7'
  },
  {
    wrapperClass: 'aspect-[4/3]',
    overlayClass: 'from-black/80 via-black/20 to-transparent',
    contentPaddingClass: 'p-4 lg:p-6',
    titleClass: 'text-lg font-bold mb-1',
    descriptionClass: 'text-xs text-white/80',
    zoomWrapperClass: 'w-12 h-12',
    zoomIconClass: 'w-6 h-6'
  },
  {
    wrapperClass: 'aspect-[4/3]',
    overlayClass: 'from-black/80 via-black/20 to-transparent',
    contentPaddingClass: 'p-4 lg:p-6',
    titleClass: 'text-lg font-bold mb-1',
    descriptionClass: 'text-xs text-white/80',
    zoomWrapperClass: 'w-12 h-12',
    zoomIconClass: 'w-6 h-6'
  },
  {
    wrapperClass: 'aspect-[4/3]',
    overlayClass: 'from-black/80 via-black/20 to-transparent',
    contentPaddingClass: 'p-4 lg:p-6',
    titleClass: 'text-lg font-bold mb-1',
    descriptionClass: 'text-xs text-white/80',
    zoomWrapperClass: 'w-12 h-12',
    zoomIconClass: 'w-6 h-6'
  },
  {
    wrapperClass: 'aspect-[4/3]',
    overlayClass: 'from-black/80 via-black/20 to-transparent',
    contentPaddingClass: 'p-4 lg:p-6',
    titleClass: 'text-lg font-bold mb-1',
    descriptionClass: 'text-xs text-white/80',
    zoomWrapperClass: 'w-12 h-12',
    zoomIconClass: 'w-6 h-6'
  },
  {
    wrapperClass: 'aspect-[4/3]',
    overlayClass: 'from-black/80 via-black/20 to-transparent',
    contentPaddingClass: 'p-4 lg:p-6',
    titleClass: 'text-lg font-bold mb-1',
    descriptionClass: 'text-xs text-white/80',
    zoomWrapperClass: 'w-12 h-12',
    zoomIconClass: 'w-6 h-6'
  }
];

const galleryItems = gallery.items.map((item, index) => ({
  ...item,
  imgThumb: `${baseUrl}${item.thumbPath}`,
  imgFull: `${baseUrl}${item.fullImagePath}`,
  ...galleryItemStyles[index]
}));

---

<section id="experiencias" class="py-20 lg:py-28 bg-white">
  <Container>
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">
        {gallery.badge}
      </span>
      <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
        {gallery.titlePrefix} <span class="text-ieee-orange">{gallery.titleHighlight}</span> {gallery.titleSuffix}
      </h2>
      <p class="text-lg text-neutral-600">
        {gallery.description}
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
      {galleryItems.map((item) => (
        <div
          class={`group relative overflow-hidden rounded-2xl cursor-pointer gallery-item ${item.wrapperClass}`}
          data-image={item.imgFull}
          data-title={item.title}
          data-description={item.modalDescription}
        >
          <img
            src={item.imgThumb}
            srcset={`${item.imgThumb} 768w, ${item.imgFull} 1280w`}
            sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
            alt={item.imageAlt}
            width="1280"
            height="720"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
          <div class={`absolute inset-0 bg-gradient-to-t ${item.overlayClass}`}></div>
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
            <div class={`${item.zoomWrapperClass} bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center`}>
              <svg class={`${item.zoomIconClass} text-white`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </div>
          </div>
          <div class={`absolute bottom-0 left-0 right-0 text-white ${item.contentPaddingClass}`}>
            <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold mb-2 ${item.badgeClass}`}>
              {item.badgeText}
            </span>
            <h3 class={item.titleClass}>{item.title}</h3>
            <p class={item.descriptionClass}>{item.cardDescription}</p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm">
  <button 
    id="lightbox-close" 
    class="absolute top-4 right-4 z-10 w-12 h-12 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center transition-colors"
    aria-label="Cerrar"
  >
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  
  <div class="max-w-5xl max-h-[90vh] mx-4 flex flex-col">
    <img 
      id="lightbox-image" 
      src="" 
      alt=""
      width="1600"
      height="900"
      class="max-w-full max-h-[80vh] object-contain rounded-lg"
      decoding="async"
    />
    <div class="mt-4 text-center text-white">
      <h3 id="lightbox-title" class="text-xl font-bold mb-2"></h3>
      <p id="lightbox-description" class="text-white/70 max-w-2xl mx-auto"></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDescription = document.getElementById('lightbox-description');
    const lightboxClose = document.getElementById('lightbox-close');
    const galleryItems = document.querySelectorAll('.gallery-item');

    // Open lightbox
    galleryItems.forEach(item => {
      item.addEventListener('click', () => {
        const image = item.getAttribute('data-image');
        const title = item.getAttribute('data-title');
        const description = item.getAttribute('data-description');

        if (lightboxImage && image) lightboxImage.src = image;
        if (lightboxImage && title) lightboxImage.alt = title;
        if (lightboxTitle && title) lightboxTitle.textContent = title;
        if (lightboxDescription && description) lightboxDescription.textContent = description;
        
        if (lightbox) {
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Close lightbox
    const closeLightbox = () => {
      if (lightbox) {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  });
</script>
