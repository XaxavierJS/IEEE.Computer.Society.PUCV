---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  url: string;
  type?:
    | 'pdf'
    | 'link'
    | 'doc'
    | 'formulario'
    | 'reglamento'
    | 'plantilla'
    | 'admision'
    | 'viajes'
    | 'recursos'
    | 'rubrica';
  publisher?: string;
}

const {
  title,
  description,
  url,
  type = 'link',
  publisher
} = Astro.props;

const typeLabel: Record<string, string> = {
  pdf: 'PDF',
  link: 'Link',
  doc: 'Documento',
  formulario: 'Formulario',
  reglamento: 'Reglamento',
  plantilla: 'Plantilla',
  admision: 'Admisión',
  viajes: 'Viajes',
  recursos: 'Recursos',
  rubrica: 'Rúbrica'
};
---

<Card class="p-6 border-ieee-orange/10" hover={true}>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h4 class="font-bold text-neutral-900 text-lg">{title}</h4>
      <p class="text-neutral-600 text-sm mt-1 leading-relaxed">{description}</p>
    </div>
    <Badge variant="outline" class="shrink-0">{typeLabel[type]}</Badge>
  </div>

  {publisher && (
    <div class="text-xs text-neutral-500 mt-3">{publisher}</div>
  )}

  <div class="mt-4">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-ieee-orange hover:text-ieee-orange-dark font-semibold transition-colors"
    >
      Ver
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</Card>
