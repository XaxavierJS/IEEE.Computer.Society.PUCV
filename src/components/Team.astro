---
import Container from './ui/Container.astro';
import Card from './ui/Card.astro';
import team from '../data/team.json';
import landingContent from '../data/landing-content.json';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const { team: teamContent } = landingContent;

const sortedMembers = team.sort((a, b) => a.order - b.order);
---

<section id="directiva" class="py-20 lg:py-28 bg-white">
  <Container>
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">
        {teamContent.badge}
      </span>
      <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-6">
        <span class="text-ieee-orange">{teamContent.titleHighlight}</span> {teamContent.titleSuffix}
      </h2>
      <p class="text-lg text-neutral-600">
        {teamContent.description}
      </p>
    </div>

    <!-- Team grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      {sortedMembers.map((member) => (
        <Card class="p-4 md:p-5 text-center group" hover={true}>
          <!-- Photo -->
          <div class="relative w-28 sm:w-32 mx-auto mb-4 overflow-hidden rounded-2xl bg-neutral-100 aspect-[3/4]">
            <img 
              src={member.photo.startsWith('/') ? `${baseUrl}${member.photo.slice(1)}` : member.photo}
              alt={`Foto de ${member.name}`}
              width="240"
              height="320"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Info -->
          <h3 class="font-bold text-neutral-900 text-lg mb-1">{member.name}</h3>
          <p class="text-sm text-ieee-orange font-medium mb-3">{member.role}</p>

          <!-- LinkedIn -->
          {member.linkedin && member.linkedin !== 'https://linkedin.com/in/' && (
            <a 
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-neutral-100 text-neutral-500 hover:bg-ieee-blue hover:text-white transition-all"
              aria-label={`LinkedIn de ${member.name}`}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
          )}
        </Card>
      ))}
    </div>

  </Container>
</section>
