---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Container from '../../components/ui/Container.astro';
import DocumentCard from '../../components/beneficios/DocumentCard.astro';
import benefits from '../../data/benefits-grouped.json';
import documents from '../../data/documents-grouped.json';

const documentTypeCategories = [
  { id: 'reglamento', label: 'Reglamentos' },
  { id: 'rubrica', label: 'Rúbricas' },
  { id: 'plantilla', label: 'Formatos' },
  { id: 'formulario', label: 'Formularios' },
  { id: 'admision', label: 'Admisión' },
  { id: 'viajes', label: 'Viajes' },
  { id: 'recursos', label: 'Recursos' }
];

const categories = [
  {
    id: 'cloud-dev',
    title: 'Cloud & Desarrollo',
    description: 'Créditos, IDEs y herramientas para desplegar proyectos y aprender cloud.',
    iconPath: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-10 5.002 5.002 0 00-9.584 1.2A4 4 0 003 15z'
  },
  {
    id: 'productivity',
    title: 'Productividad',
    description: 'Herramientas para estudiar, colaborar y organizar tus proyectos.',
    iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z'
  },
  {
    id: 'design',
    title: 'Diseño & Creatividad',
    description: 'Software para UI/UX, creatividad y prototipado con descuentos o licencias.',
    iconPath: 'M12 20h9M16.5 3.5a2.121 2.121 0 113 3L7 19l-4 1 1-4 12.5-12.5z'
  },
  {
    id: 'learning',
    title: 'Aprendizaje & Cursos',
    description: 'Plataformas de cursos, certificaciones y laboratorios prácticos.',
    iconPath: 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422A12.083 12.083 0 0112 21.5c-2.28 0-4.421-.62-6.16-1.922L12 14z'
  },
  {
    id: 'multimedia',
    title: 'Multimedia',
    description: 'Descuentos para estudiantes en música, streaming y suscripciones.',
    iconPath: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.26a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  }
];
---

<Layout>
  <Navbar />
  <main>
    <!-- Hero Section -->
    <section class="relative py-20 lg:py-32 overflow-hidden bg-gradient-to-br from-neutral-50 via-white to-ieee-orange/5">
      <!-- Background elements -->
      <div class="absolute top-20 right-0 w-96 h-96 bg-ieee-orange/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-ieee-blue/5 rounded-full blur-3xl"></div>

      <Container class="relative">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-ieee-orange/10 text-ieee-orange px-4 py-2 rounded-full text-sm font-medium mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-ieee-orange opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-ieee-orange"></span>
            </span>
            Beneficios Exclusivos
          </div>

          <!-- Main title -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-neutral-900 mb-6 leading-tight">
            Beneficios para
            <span class="text-ieee-orange"> Estudiantes</span>
          </h1>

          <!-- Description -->
          <p class="text-xl text-neutral-600 max-w-2xl mx-auto mb-8 leading-relaxed">
            Accede a herramientas, licencias y descuentos exclusivos para estudiantes PUCV. 
            Cloud, IDEs, diseño, productividad y más.
          </p>

          <!-- Stats -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
            <div class="text-center">
              <div class="text-2xl font-bold text-ieee-orange">{benefits.length}+</div>
              <div class="text-sm text-neutral-500">Beneficios</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-ieee-orange">{categories.length}</div>
              <div class="text-sm text-neutral-500">Categorías</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-ieee-orange">{documents.length}+</div>
              <div class="text-sm text-neutral-500">Documentos</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-ieee-orange">100%</div>
              <div class="text-sm text-neutral-500">Gratis</div>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <!-- Categorías y Beneficios -->
    <section class="py-16 lg:py-24 bg-neutral-50">
      <Container class="relative">
        <div class="max-w-6xl mx-auto">
          <!-- Categorías arriba -->
          <div class="flex flex-wrap justify-center gap-3 mb-12">
            {categories.map(category => (
              <button
                data-category-button
                data-category-id={category.id}
                class="flex items-center gap-2 px-6 py-3 border-2 border-neutral-200 rounded-xl font-medium transition-all hover:border-ieee-orange/40 hover:shadow-sm"
              >
                <svg class="w-5 h-5 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={category.iconPath} />
                </svg>
                <span>{category.title}</span>
              </button>
            ))}
          </div>

          <!-- Contenido de categorías -->
          <div class="space-y-12">
            {categories.map(category => {
              const categoryBenefits = benefits[category.id] || [];
              
              return (
                <div data-category-panel data-category-id={category.id} class="hidden">
                  <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold text-neutral-900 mb-4">{category.title}</h2>
                    <p class="text-lg text-neutral-600 max-w-2xl mx-auto">{category.description}</p>
                  </div>

                  {/* Beneficios como cartas */}
                  {categoryBenefits.length > 0 && (
                    <div class="mb-12">
                      <h3 class="text-xl font-semibold text-neutral-900 mb-6">Beneficios disponibles</h3>
                      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {categoryBenefits.map((benefit) => (
                          <div class="bg-white border border-neutral-200 rounded-xl p-6 hover:shadow-lg transition-shadow hover:border-ieee-orange/30">
                            <div class="flex items-start justify-between mb-4">
                              <h4 class="text-lg font-semibold text-neutral-900">{benefit.title}</h4>
                              {benefit.verification && (
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-ieee-orange/10 text-ieee-orange">
                                  Verificado
                                </span>
                              )}
                            </div>
                            <p class="text-neutral-600 mb-4">{benefit.description}</p>
                            <div class="text-sm text-neutral-500 mb-4">
                              <strong>Acceso:</strong> {benefit.access}
                            </div>
                            <a 
                              href={benefit.url} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="inline-flex items-center text-ieee-orange hover:text-ieee-orange-dark font-medium"
                            >
                              Solicitar beneficio
                              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            </a>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </Container>
    </section>

    <!-- Todos los Documentos -->
    <section class="py-16 lg:py-24 bg-white" id="documentos">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">Documentos</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-4">
            Todos los <span class="text-ieee-orange">documentos</span>
          </h2>
          <p class="text-lg text-neutral-600">
            Reglamentos, instructivos y links oficiales para acceder a convenios y recursos.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mb-12">
          {documentTypeCategories.map((t) => (
            <button
              data-document-type-button
              data-document-type-id={t.id}
              type="button"
              class="px-6 py-3 border-2 border-neutral-200 rounded-xl font-medium transition-all hover:border-ieee-orange/40 hover:shadow-sm"
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="space-y-12">
          {documentTypeCategories.map((t) => {
            const docs = documents[t.id] || [];
            const sortedDocs = docs.sort((a, b) => a.title.localeCompare(b.title));

            return (
              <div data-document-type-panel data-document-type-id={t.id} class="hidden">
                {docs.length === 0 ? (
                  <div class="text-center text-neutral-600">Aún no hay documentos cargados en esta categoría.</div>
                ) : (
                  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {sortedDocs.map((d) => (
                      <DocumentCard
                        title={d.title}
                        description={d.description}
                        url={d.url}
                        type={d.type}
                        publisher={d.publisher}
                      />
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll('[data-category-button]'));
  const panels = Array.from(document.querySelectorAll('[data-category-panel]'));

  const docButtons = Array.from(document.querySelectorAll('[data-document-type-button]'));
  const docPanels = Array.from(document.querySelectorAll('[data-document-type-panel]'));

  function setActive(categoryId) {
    buttons.forEach((btn) => {
      const isActive = btn.getAttribute('data-category-id') === categoryId;
      btn.classList.toggle('border-ieee-orange', isActive);
      btn.classList.toggle('bg-ieee-orange/5', isActive);
      btn.classList.toggle('shadow-sm', isActive);
      btn.classList.toggle('border-neutral-200', !isActive);
      btn.classList.toggle('hover:border-ieee-orange/40', !isActive);
    });

    panels.forEach((p) => {
      const isActive = p.getAttribute('data-category-id') === categoryId;
      p.classList.toggle('hidden', !isActive);
      p.style.display = '';
    });
  }

  function setActiveDocType(typeId) {
    docButtons.forEach((btn) => {
      const isActive = btn.getAttribute('data-document-type-id') === typeId;
      btn.classList.toggle('border-ieee-orange', isActive);
      btn.classList.toggle('bg-ieee-orange/5', isActive);
      btn.classList.toggle('shadow-sm', isActive);
      btn.classList.toggle('border-neutral-200', !isActive);
      btn.classList.toggle('hover:border-ieee-orange/40', !isActive);
    });

    docPanels.forEach((p) => {
      const isActive = p.getAttribute('data-document-type-id') === typeId;
      p.classList.toggle('hidden', !isActive);
      p.style.display = '';
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const categoryId = btn.getAttribute('data-category-id');
      if (!categoryId) return;

      setActive(categoryId);

      const url = new URL(window.location.href);
      url.searchParams.set('cat', categoryId);
      window.history.replaceState({}, '', url.toString());

      const section = document.querySelector('section[class*="bg-neutral-50"]');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  const initialCat = new URL(window.location.href).searchParams.get('cat');
  if (initialCat) {
    setActive(initialCat);
  } else {
    const firstCategoryId = 'cloud-dev';
    setActive(firstCategoryId);
  }

  const initialDocType = new URL(window.location.href).searchParams.get('docs');
  if (initialDocType) {
    setActiveDocType(initialDocType);
  } else {
    setActiveDocType('reglamento');
  }

  docButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const typeId = btn.getAttribute('data-document-type-id');
      if (!typeId) return;

      setActiveDocType(typeId);

      const url = new URL(window.location.href);
      url.searchParams.set('docs', typeId);
      window.history.replaceState({}, '', url.toString());

      const section = document.getElementById('documentos');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
