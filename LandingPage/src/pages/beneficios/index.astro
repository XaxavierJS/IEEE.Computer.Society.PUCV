---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Container from '../../components/ui/Container.astro';
import DocumentCard from '../../components/beneficios/DocumentCard.astro';
import benefits from '../../data/benefits-grouped.json';
import documents from '../../data/documents-grouped.json';

type BenefitCategoryId = 'cloud-dev' | 'productivity' | 'design' | 'learning' | 'multimedia' | 'bienestar' | 'ieee';

interface BenefitItem {
  categoryId: BenefitCategoryId;
  title: string;
  description: string;
  access: string;
  url: string;
  verification: string;
  _id: string;
}

type DocumentTypeId = 'reglamento' | 'rubrica' | 'plantilla' | 'formulario' | 'admision' | 'viajes' | 'recursos';

interface DocumentItem {
  title: string;
  description: string;
  url: string;
  type: 'reglamento' | 'admision' | 'viajes' | 'link' | 'plantilla' | 'formulario' | 'recursos' | 'pdf' | 'rubrica' | 'doc';
  publisher: string;
  _id: string;
}

const totalBenefits = Object.values(benefits).flat().length;
const benefitsByCategory = benefits as Record<BenefitCategoryId, BenefitItem[]>;
const documentsByType = documents as Record<string, DocumentItem[]>;

const documentTypeCategories: Array<{ id: DocumentTypeId; label: string }> = [
  { id: 'reglamento', label: 'Reglamentos' },
  { id: 'rubrica', label: 'Rúbricas' },
  { id: 'plantilla', label: 'Formatos' },
  { id: 'formulario', label: 'Formularios' },
  { id: 'admision', label: 'Admisión' },
  { id: 'viajes', label: 'Viajes' },
  { id: 'recursos', label: 'Recursos' }
];

const categories: Array<{ id: BenefitCategoryId; title: string; description: string; iconPath: string }> = [
  {
    id: 'cloud-dev',
    title: 'Cloud & Desarrollo',
    description: 'Créditos, IDEs y herramientas para desplegar proyectos y aprender cloud.',
    iconPath: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-10 5.002 5.002 0 00-9.584 1.2A4 4 0 003 15z'
  },
  {
    id: 'productivity',
    title: 'Productividad',
    description: 'Herramientas para estudiar, colaborar y organizar tus proyectos.',
    iconPath: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5l5 5v11a2 2 0 01-2 2z'
  },
  {
    id: 'design',
    title: 'Diseño & Creatividad',
    description: 'Software para UI/UX, creatividad y prototipado con descuentos o licencias.',
    iconPath: 'M12 20h9M16.5 3.5a2.121 2.121 0 113 3L7 19l-4 1 1-4 12.5-12.5z'
  },
  {
    id: 'learning',
    title: 'Aprendizaje & Cursos',
    description: 'Plataformas de cursos, certificaciones y laboratorios prácticos.',
    iconPath: 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422A12.083 12.083 0 0112 21.5c-2.28 0-4.421-.62-6.16-1.922L12 14z'
  },
  {
    id: 'multimedia',
    title: 'Multimedia',
    description: 'Herramientas y planes para contenido visual, presentaciones y servicios multimedia.',
    iconPath: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.26a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    id: 'bienestar',
    title: 'Bienestar & Salud',
    description: 'Atención médica, psicológica, seguros estudiantiles y apoyo integral PUCV.',
    iconPath: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z'
  },
  {
    id: 'ieee',
    title: 'IEEE Membership',
    description: 'Beneficios exclusivos por pertenecer a IEEE y IEEE Computer Society.',
    iconPath: 'M12 2l2.4 4.86L20 7.8l-4 3.9.94 5.5L12 14.8 7.06 17.2 8 11.7 4 7.8l5.6-.94L12 2z'
  }
];

---

<Layout
  title="Beneficios IEEE Computer Society PUCV | Convenios y Recursos"
  description="Explora beneficios académicos y profesionales para estudiantes PUCV e IEEE Computer Society: software, cursos, recursos y documentos oficiales."
>
  <Navbar />
  <main>
    <!-- Categorías y Beneficios -->
    <section class="py-10 lg:py-14 bg-neutral-50">
      <Container class="relative">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-8 lg:mb-10">
            <span class="inline-flex items-center gap-2 bg-ieee-orange/10 text-ieee-orange px-4 py-2 rounded-full text-sm font-medium mb-5">
              Beneficios para la comunidad estudiantil
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 mb-4">
              Beneficios PUCV e IEEE Computer Society
            </h1>
            <p class="text-lg text-neutral-600 max-w-3xl mx-auto">
              Explora los beneficios por categoría y encuentra rápidamente lo que necesitas.
            </p>
          </div>

          <!-- Categorías arriba -->
          <div class="flex flex-wrap justify-center gap-3 mb-12">
            {categories.map(category => (
              <button
                data-category-button
                data-category-id={category.id}
                class="flex items-center gap-2 px-6 py-3 border-2 border-neutral-200 rounded-xl font-medium transition-all hover:border-ieee-orange/40 hover:shadow-sm"
              >
                <svg class="w-5 h-5 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={category.iconPath} />
                </svg>
                <span>{category.title}</span>
              </button>
            ))}
          </div>

          <!-- Contenido de categorías -->
          <div class="space-y-12">
            {categories.map(category => {
              const categoryBenefits = benefitsByCategory[category.id] || [];
              
              return (
                <div data-category-panel data-category-id={category.id} class="hidden">
                  <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold text-neutral-900 mb-4">{category.title}</h2>
                    <p class="text-lg text-neutral-600 max-w-2xl mx-auto">{category.description}</p>
                  </div>
                  {categoryBenefits.length > 0 ? (
                    <div class="mb-12">
                      <h3 class="text-xl font-semibold text-neutral-900 mb-6">Beneficios disponibles</h3>
                      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {categoryBenefits.map((benefit) => (
                          <div class="bg-white border border-neutral-200 rounded-xl p-6 hover:shadow-lg transition-shadow hover:border-ieee-orange/30">
                            <div class="flex items-start justify-between mb-4">
                              <h4 class="text-lg font-semibold text-neutral-900">{benefit.title}</h4>
                              {benefit.verification && (
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-ieee-orange/10 text-ieee-orange">
                                  Verificado
                                </span>
                              )}
                            </div>
                            <p class="text-neutral-600 mb-4">{benefit.description}</p>
                            <div class="text-sm text-neutral-500 mb-4">
                              <strong>Acceso:</strong> {benefit.access}
                            </div>
                            <a 
                              href={benefit.url} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="inline-flex items-center text-ieee-orange hover:text-ieee-orange-dark font-medium"
                            >
                              Solicitar beneficio
                              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                              </svg>
                            </a>
                          </div>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div class="text-center text-neutral-600 bg-white border border-neutral-200 rounded-xl p-8 mb-12">
                      No hay beneficios cargados en esta categoría por ahora.
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </Container>
    </section>



    <!-- Todos los Documentos -->
    <section class="py-16 lg:py-24 bg-white" id="documentos">
      <Container>
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-ieee-orange font-semibold text-sm uppercase tracking-wider">Documentos</span>
          <h2 class="text-3xl lg:text-5xl font-bold text-neutral-900 mt-4 mb-4">
            Todos los <span class="text-ieee-orange">documentos</span>
          </h2>
          <p class="text-lg text-neutral-600">
            Reglamentos, instructivos y links oficiales para acceder a convenios y recursos.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 mb-12">
          {documentTypeCategories.map((t) => (
            <button
              data-document-type-button
              data-document-type-id={t.id}
              type="button"
              class="px-6 py-3 border-2 border-neutral-200 rounded-xl font-medium transition-all hover:border-ieee-orange/40 hover:shadow-sm"
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="space-y-12">
          {documentTypeCategories.map((t) => {
            const docs = documentsByType[t.id] || [];
            const sortedDocs = [...docs].sort((a, b) => a.title.localeCompare(b.title));

            return (
              <div data-document-type-panel data-document-type-id={t.id} class="hidden">
                {docs.length === 0 ? (
                  <div class="text-center text-neutral-600">Aún no hay documentos cargados en esta categoría.</div>
                ) : (
                  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {sortedDocs.map((d) => (
                      <DocumentCard
                        title={d.title}
                        description={d.description}
                        url={d.url}
                        type={d.type}
                        publisher={d.publisher}
                      />
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { setupFilterTabs } from '../../lib/filterTabs';

  setupFilterTabs({
    buttonSelector: '[data-category-button]',
    panelSelector: '[data-category-panel]',
    idAttribute: 'data-category-id',
    defaultId: 'cloud-dev',
    queryParam: 'cat',
    scrollTargetSelector: 'section[class*="bg-neutral-50"]'
  });

  setupFilterTabs({
    buttonSelector: '[data-document-type-button]',
    panelSelector: '[data-document-type-panel]',
    idAttribute: 'data-document-type-id',
    defaultId: 'reglamento',
    queryParam: 'docs',
    scrollTargetSelector: '#documentos'
  });
</script>
