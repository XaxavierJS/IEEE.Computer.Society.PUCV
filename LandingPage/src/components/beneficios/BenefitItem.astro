---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  url?: string;
  access?: string;
  verification?: 'email' | 'email_or_certificate' | 'institutional' | 'third_party';
  tags?: string[];
}

const {
  title,
  description,
  url,
  access,
  verification,
  tags = []
} = Astro.props;

const verificationLabel: Record<string, string> = {
  email: 'Correo institucional',
  email_or_certificate: 'Correo o certificado',
  institutional: 'Institucional',
  third_party: 'Verificación externa'
};
---

<Card class="p-6" hover={true}>
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-4">
      <h4 class="text-lg font-bold text-neutral-900">
        <span class="text-ieee-orange">•</span> {title}
      </h4>
      {verification && (
        <Badge variant="outline" class="shrink-0">{verificationLabel[verification]}</Badge>
      )}
    </div>

    <p class="text-neutral-600 leading-relaxed">{description}</p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((t) => (
          <Badge variant="default">{t}</Badge>
        ))}
      </div>
    )}

    {access && (
      <div class="bg-neutral-50 border border-ieee-orange/20 rounded-xl p-4">
        <div class="text-sm font-semibold text-neutral-900 mb-1">Cómo acceder</div>
        <div class="text-sm text-neutral-600 leading-relaxed">{access}</div>
      </div>
    )}

    {url && (
      <div>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-ieee-orange hover:text-ieee-orange-dark font-semibold transition-colors"
        >
          Ir al sitio
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}
  </div>
</Card>
